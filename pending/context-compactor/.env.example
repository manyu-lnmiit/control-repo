# context-compactor core library needs no configuration or secrets.
#
# These are only used by the optional FastAPI service (context_compactor.api)
# and example scripts that wire in a real LLM for abstractive summarization.

# Host/port for `uvicorn context_compactor.api:app`
CONTEXT_COMPACTOR_HOST=0.0.0.0
CONTEXT_COMPACTOR_PORT=8000

# Optional: only needed if you plug an LLM-backed Summarizer into the
# Compactor (see examples/llm_summarizer.py). Never committed with a real
# value.
OPENAI_API_KEY=
