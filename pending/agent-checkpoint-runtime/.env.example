# agentflow's core runtime has no required environment variables -- it is
# pure Python + SQLite. These are optional knobs used only by examples/ or
# if you wire agentflow into a real LLM-backed agent.

# Path to the SQLite store used by the CLI and examples.
AGENTFLOW_DB_PATH=agentflow.db

# Example: if you extend examples/research_agent_workflow.py to call a real
# LLM provider, put your key here (never commit a real value).
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
