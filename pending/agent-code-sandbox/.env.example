# Optional environment variable overrides for agent-code-sandbox.
# Copy to .env and adjust as needed (the package does not auto-load .env
# files -- this is documentation for wiring your own process manager /
# shell / container to set these).

# Path to the JSONL audit log file. Defaults to
# ~/.agent_code_sandbox/audit.jsonl if unset.
AGENT_SANDBOX_AUDIT_LOG_PATH=./audit.jsonl
