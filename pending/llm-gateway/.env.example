# Copy to .env and fill in real values locally. Never commit a real .env.

# API key for the real OpenAI-compatible backend referenced in
# config.example.yaml (api_key_env: OPENAI_API_KEY). Only required if you
# enable a non-mock provider.
OPENAI_API_KEY=

# Optional: path to a gateway config file, used by `llm-gateway serve` and
# the FastAPI app factory when no --config flag is passed.
LLM_GATEWAY_CONFIG=./config.example.yaml
