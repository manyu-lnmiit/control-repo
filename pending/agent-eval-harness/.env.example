# agent-eval-harness does not require any credentials to run its built-in scorers or the
# MockAgent example. These variables are only needed if you wire in your own AgentRunner
# that calls a hosted LLM API (e.g. inside examples/demo_agent.py or a module you point
# --agent at). Copy this file to .env and fill in real values locally; never commit .env.

# Example: used by a custom AgentRunner implementation, not by the harness itself.
OPENAI_API_KEY=

# Optional: override request timeout (seconds) inside a custom AgentRunner.
AGENT_REQUEST_TIMEOUT_S=30
