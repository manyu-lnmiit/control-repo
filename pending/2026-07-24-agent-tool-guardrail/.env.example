# Copy to .env and adjust as needed. No real secrets are required to run
# this project locally -- it does not call any external LLM or paid API.

# Path to the YAML policy file the service loads on each request.
GUARDRAIL_POLICY_PATH=policies/example_policy.yaml

# Path to the JSONL trace file the service appends call records to.
GUARDRAIL_TRACE_PATH=traces/service.jsonl

# Optional: total cost budget (float) enforced across the service's
# lifetime. Leave unset for no budget enforcement.
GUARDRAIL_MAX_BUDGET=10.0
