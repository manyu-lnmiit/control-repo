# llm-output-contract has no required runtime secrets — the library is offline
# and never calls a model itself; you supply the model call.
#
# These variables are only relevant if you wire the retry loop to a real
# provider in your own code (see examples/). Copy this file to `.env` and fill
# in whatever your integration uses. Never commit the resulting `.env`.

# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...

# Optional: default maximum repair attempts for your integration layer.
# OUTPUT_CONTRACT_MAX_ATTEMPTS=3
